{
  "name": "muslimowned-sg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "postbuild": "mkdir -p .next/standalone/.next && cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "USE_PGLITE=1 npx vitest run tests/db",
    "emulators": "echo 'Firebase emulators are retired. Use DATABASE_URL or USE_PGLITE=1.'",
    "seed": "npx tsx scripts/seed.ts",
    "seed:demo": "npx tsx scripts/seed-demo.ts",
    "migrate:firestore": "npx tsx scripts/migrate-firestore.ts",
    "job:confirmations": "npx tsx scripts/run-confirmations.ts",
    "backfill:founding": "npx tsx scripts/backfill-founding.ts"
  },
  "dependencies": {
    "@mdxeditor/editor": "^4.2.5",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.5.0",
    "gray-matter": "^4.0.3",
    "next": "^15.5.4",
    "postcss": "^8.5.28",
    "postgres": "^3.4.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^4.8.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "firebase-tools": "^14.17.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
