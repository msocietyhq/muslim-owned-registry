rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /uen/{uid}/{businessId}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == uid || request.auth.token.admin == true
      );
      allow write: if request.auth != null && (
        request.auth.uid == uid || request.auth.token.admin == true
      )
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches("application/pdf|image/.*");
    }

    match /list-quick/{guestId}/photos/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /list-quick/{guestId}/uen/{fileName} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    match /listing-photos/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == uid || request.auth.token.admin == true
      )
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }

    match /team-photos/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }
  }
}
