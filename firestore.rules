rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /owners/{id} {
      allow read: if true;
      allow create, update: if isUser(id) || isAdmin();
      allow delete: if isAdmin();
    }

    match /businesses/{id} {
      allow read: if resource.data.status == "live"
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();
      allow write: if false;
    }

    match /businesses_history/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /owners_history/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /tags/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tags_history/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /verifications/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /verifications_history/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /adminTasks/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /listingDrafts/{id} {
      allow read, write: if false;
    }

    match /loginChallenges/{id} {
      allow read, write: if false;
    }

    match /listingLinks/{id} {
      allow read, write: if false;
    }

    match /stats/{id} {
      allow read, write: if false;
    }

    match /listing_stats/{id} {
      allow read, write: if false;
    }

    match /listing_seen/{id} {
      allow read, write: if false;
    }

    match /site_seen/{id} {
      allow read, write: if false;
    }

    match /teamMembers/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /admins/{id} {
      allow read, write: if false;
    }

    match /admins_history/{id} {
      allow read, write: if false;
    }
  }
}
